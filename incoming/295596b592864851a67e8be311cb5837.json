{"id": "295596b592864851a67e8be311cb5837", "channel": "stable", "base_version": "1.10.7", "sha256": "f49e071424e60202e6bc593170cc9ed72f2ce10e9a89c45fe651a4d8363be641", "blobs": ["cc98214bc2b8de2ae41df395e33b026fa7989849"], "notes": ["\u65b0\u589e06\u89c6\u9891\u6df1\u5ea6\u590d\u523b\uff1a\u62d6\u5165\u672c\u5730\u89c6\u9891\uff0c\u6216\u7c98\u8d34\u8c31\u7801\u4f5c\u54c1\u94fe\u63a5\u4e0b\u8f7d\u5230\u5de5\u4f5c\u533a\u3002", "\u652f\u6301\u539f\u7247\u9884\u89c8\u3001\u8d77\u6b62\u533a\u95f4\u3001\u5220\u9664\u4e2d\u6bb5\u4e0e\u591a\u6bb5\u62fc\u63a5\uff0c\u751f\u6210\u72ec\u7acb\u526a\u8f91\u9884\u89c8\uff1b\u539f\u89c6\u9891\u4fdd\u7559\u3002", "\u526a\u540e\u89c6\u9891\u9010\u5e27\u6df1\u5ea6\u5206\u6790\u5e76\u9002\u914d\u6240\u9009\u63d0\u793a\u8bcd\uff0c\u5c55\u793a\u771f\u5b9e\u5e27\u3001\u539f\u7247\u65f6\u95f4\u6620\u5c04\u53ca\u5b9e\u9645\u91c7\u7528\u4f4d\u7f6e\u3002", "\u590d\u523b\u7a3f\u7ee7\u7eed\u4fdd\u62a4\u53f0\u8bcd\u3001\u753b\u98ce\u3001\u8d44\u4ea7\u548c\u5267\u60c5\uff0c\u72ec\u7acb\u5ba1\u6838\u540e\u68c0\u67e5\u5b8c\u6574\u7a3f\u4e0e\u5dee\u5f02\uff0c\u786e\u8ba4\u540e\u624d\u56de\u586b\u3002", "\u652f\u6301200MB\u300110\u5206\u949f\u4ee5\u5185\u7684\u89c6\u9891\uff1b\u7528\u4e8e\u590d\u523b\u7684\u4fdd\u7559\u533a\u95f4\u5408\u8ba1\u6700\u591a60\u79d2\u3002"]}